{"policyVersion":3,"items":[{"translations":{"en":["",""],"ja":["",""]},"airedAt":null,"relations":[],"id":"mal-1055","ids":{"shikimori":1055,"mal":1055,"anilist":null,"kodik":"serial-26601"},"kodikIds":["serial-26602","serial-28686","serial-26601"],"kodikRevisions":{"serial-26602":"2020-06-08T10:52:41Z","serial-28686":"2020-08-14T21:39:28Z","serial-26601":"2020-06-08T10:51:42Z"},"title":"Блейм!","originalTitle":"Blame!","alt":"Виновен","description":"Люди, считающие себя венцом творения, создают искусственную жизнь, полагая, что могут её контролировать. Но в один момент она начинает развиваться вне зависимости от их воли, оставляя людей далеко позади и отрицая возможность дальнейшего сосуществования. В этот момент рождается Мегаструктура, многоуровневый бесконечный лабиринт, в котором люди ведут постоянную борьбу за выживание. Однако в этой, казалось бы, безнадёжной ситуации, в сердцах людей ещё теплится надежда на будущее. Сетевые Терминальные Гены. Отыскавший их сможет подключиться к Сетевой сфере и остановить рост Мегаструктуры, но найдётся ли тот, кому это по силам.","year":2003,"type":"ONA","genres":["сэйнэн","Драма","Фантастика","Триллер","меха","психологическое","выживание"],"rating":5.92,"popularity":0,"ongoing":false,"relatedMalIds":[],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/1055/ac607f59c119de446b1565cab6ae1dda.jpeg","width":225,"height":329},"backdrop":{"url":"https://shikimori.io/system/screenshots/original/814daac4df308e74bf608414ff11c1b0088e8727.jpg","width":710,"height":384}},"releasedEpisodes":[1,2,3,4,5,6],"episodes":[{"number":1,"ordinal":1,"season":1,"audio":[{"id":"kodik-739","dubId":"739","label":"Animedia","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-26602","translationId":"739","url":"https://kodikplayer.com/seria/664060/c74848b20b836d889c989206d5a5732c/720p","season":1,