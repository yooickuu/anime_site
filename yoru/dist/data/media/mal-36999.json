ater released as a 6-part OVA on Blu-ray/DVD from February to March 2019."],"ja":["続・終物語",""]},"kodikRevisions":{"serial-72014":"2025-12-19T14:43:38Z","serial-47171":"2022-11-29T11:06:38Z","serial-49024":"2023-07-16T19:13:03Z"},"kodikIds":["serial-72014","serial-47171","serial-49024"],"relatedMalIds":[21855,35247,57864],"rating":8.44,"relations":[{"id":21855,"relation":"sequel"},{"id":35247,"relation":"prequel"},{"id":57864,"relation":"sequel"}],"availableEpisodeCount":6}]}