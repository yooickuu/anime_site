{"policyVersion":3,"items":[{"translations":{"en":["Yozakura Quartet: Tsuki ni Naku","\"Tsuki ni Naku\" will take the story content from volume 11 of the manga, which features a visit to an onsen by the members of the Hiizumi Life Councelling Office, while the town's police force have to deal with a new youkai-hunter threat.\nThis OVA is bundled with the limited edition of the manga (14th, 15th, and 16th)."],"ja":["夜桜四重奏 ツキニナク",""]},"airedAt":null,"relations":[{"id":18497,"relation":"prequel"}],"id":"mal-18499","ids":{"shikimori":18499,"mal":18499,"anilist":18499,"kodik":"serial-16398"},"kodikIds":["serial-35313","serial-16398"],"kodikRevisions":{"serial-35313":"2021-06-19T07:37:35Z","serial-16398":"2019-11-30T20:51:16Z"},"title":"Вишнёвый квартет: Воя на луну","originalTitle":"Yozakura Quartet: Tsuki ni Naku","alt":"Квартет Сакуры / Квартет ночной Сакуры: Воя на луну OVA-2 夜桜四重奏 ツキニナク","description":"История описывает события 11 тома манги. Работники «Офиса консультаций Хиидзуми », выиграв в лотерею поездку на курорт, отправляются на заслуженный отдых. Тем временем, полиция города сталкивается с новой угрозой – охотником на ёкаев. OVA выпущена вместе с ограниченным изданием 14-го, 15-го и 16-го томов манги.","year":2013,"type":"OVA","genres":["Сёнен","Экшен","Комедия","Фэнтези","мифология","городское фэнтези"],"rating":7.43,"popularity":9262,"ongoing":false,"relatedMalIds":[18497],"artwork":{"poster":{"url":"https://s4.anilist.co/file/anilistcdn/media/anime/cover/medium/18499.jpg","width":225,"height":311},"backdrop":{"url":"https://shikimori.io/system/screenshots/original/638996667578feab8cca4f1711fb5bbdfbc45868.jpg","width":896,"height":504}},"releasedEpisodes":[1,2,3,4,5,6],"episodes":[{"number":1,"ordinal":1,"season":1,"audio":[{"id":"kodik-609","dubId":"609","label":"AniDUB","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial