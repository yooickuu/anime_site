":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-20474","translationId":"767","url":"https://kodikplayer.com/seria/547492/ac4e6ae8fe0d15f45fd0e39a4bab457f/720p","season":1,"ordinal":13}},{"id":"kodik-609","dubId":"609","label":"AniDUB","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-3485","translationId":"609","url":"https://kodikplayer.com/seria/100817/b3c4bd195e8a5deb4f719ebc74789624/720p","season":1,"ordinal":13}},{"id":"kodik-610","dubId":"610","label":"AniLibria.TV","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-6586","translationId":"610","url":"https://kodikplayer.com/seria/175243/1499c6b7c4ced38a0abfc50592c59b83/720p","season":1,"ordinal":13}}],"ordinal":13}],"translations":{"en":["Celestial Method","It's been seven years since Nonoka Komiya last lived in Lake Kiriya City. However, while she knew that there would be changes in the town, she's still unprepared for what she finds upon her return: A giant saucer hovers over the entire city, as it has since shortly after she and her family left. Stranger yet, a girl she doesn't know, Noel, is waiting for her, claiming that they have met before. Confused, Nonaka tries to focus on reconnecting with her old friends, but odd memories, suppressed in the wake of her mother's death, begin to float to the top of her consciousness. Can it be that she has met Noel before? And how does this connect with the appearance of the saucer itself? To solve the riddle, Nonoka must join with her friends and rediscover the events that occurred before she left Lake Kiriya.\n\n\n\n(Source: Sentai Filmworks)"],"ja":["天体のメソッド",""]},"kodikRevisions":{"serial-20474":"2019-12-29T06:55:12Z","seria