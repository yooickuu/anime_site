{"policyVersion":3,"items":[{"id":"mal-512","ids":{"shikimori":512,"mal":512,"anilist":512,"kodik":"movie-101689"},"kodikIds":["movie-3761","movie-101695","movie-51333","movie-101689","movie-90933"],"kodikRevisions":{"movie-3761":"2019-11-16T15:40:22Z","movie-101695":"2024-03-08T07:48:40Z","movie-51333":"2020-03-11T02:11:11Z","movie-101689":"2024-03-07T21:18:19Z","movie-90933":"2023-04-16T17:16:11Z"},"title":"Ведьмина служба доставки","originalTitle":"Majo no takkyûbin","alt":"Служба доставки Кики / Majo no Takkyuubin Kiki's Delivery Service 魔女の宅急便","description":"Кики — тринадцатилетняя девочка, живущая в деревне вместе с матерью-ведьмой, которая варит целебные зелья для местных жителей. У ведьм есть традиция: по достижении 13 лет ведьма должна улететь в город и прожить там один год. Таким образом Кики покидает дом матери и отправляется в путь со своим лучшим другом Дзи-Дзи , весьма говорливым чёрным котом. Кики прилетает в Корико, красивый город на берегу моря, и после череды неприятностей находит место для проживания и знакомится с местными жителями. Увы, девочка обладает лишь одной ведьминой способностью — летать на метле. Чтобы выжить в городе, Кики открывает службу доставки.","year":1989,"type":"MOVIE","genres":["Приключения","Комедия","Драма","Фэнтези","удостоено наград"],"rating":8.24,"popularity":188979,"ongoing":false,"relatedMalIds":[],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/512/6fafe37b1edc66874050a3f8940f35ab.jpeg","width":705,"height":1000},"backdrop":{"url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/512-Ssp3EE2NdeoA.jpg","width":1900,"height":400}},"releasedEpisodes":[1],"episodes":[{"number":1,"ordinal":1,"season":1,"audio":[{"id":"kodik-704","dubId":"704","label":"Дублированный","language":"ru","original":false,"duration":6182.645,"sources":[{"quality":720,"url":"https://cloud.solodcdn.com/useruploads/737f2f73-5d39-4fa3-94cb-b38c63ec3021/2b1c86778dc4d871ab4b701b3042ce34:2026102404/720.mp4:hls:manifest.m3