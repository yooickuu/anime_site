{"policyVersion":3,"items":[{"translations":{"en":["",""],"ja":["",""]},"airedAt":null,"relations":[],"id":"mal-15117","ids":{"shikimori":15117,"mal":15117,"anilist":null,"kodik":"serial-61270"},"kodikIds":["serial-20968","serial-47558","serial-61270"],"kodikRevisions":{"serial-20968":"2020-01-10T16:51:24Z","serial-47558":"2022-12-24T19:07:18Z","serial-61270":"2024-08-18T09:25:14Z"},"title":"Одному лишь Богу ведомый мир: Глава Тэнри","originalTitle":"Kami nomi zo Shiru Sekai: Tenri Hen","alt":"Мир, ведомый Лишь богу OVA-2","description":"Кэйма планировал все летние каникулы провести за видеоиграми. Однако неожиданный визит Тэнри Аюкавы — подруги детства, когда-то жившей по соседству — внес значительные правки в его безупречный сценарий. Более того — Кэйма совсем не помнит девушку и, по ее словам, она также не припоминает, чтобы была с ним знакома. Казалось бы, проблема исчерпана, но Тэнри вдруг начинает странно себя вести, и это не похоже на проделки шального духа. В чем же тогда дело? Озадаченный этим вопросом, Кэйма решает найти ответ. Два дополнительных эпизода, выпущенные в комплекте с девятнадцатым томом оригинальной манги « Одному лишь Богу ведомый мир ».","year":2012,"type":"OVA","genres":["Сёнен","Комедия","Романтика","Сверхъестественное","гарем","култура отаку"],"rating":7.66,"popularity":0,"ongoing":false,"relatedMalIds":[],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/15117/c64cd4222af9d39b3b900d1e62349e26.jpeg","width":320,"height":450},"backdrop":{"url":"https://shikimori.io/system/screenshots/original/8740ed1cf1cd16a551f6a195eac97bb15a179c4b.gif","width":1000,"height":561}},"releasedEpisodes":[1,2],"episodes":[{"number":1,"ordinal":1,"season":2,"audio":[{"id":"kodik-609","dubId":"609","label":"AniDUB","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-20968","translationId":"609","url":"https