am":true},{"quality":480,"url":"https://cache-rfn.libria.fun/videos/media/ts/6456/12/480/2c14f57aaa3b01e2db42c79d13844dfc.m3u8?countryIso=KZ&isAuthorized=0&isWithVideoAds=1&isWithVideoAdsAlways=1","stream":true}],"subtitles":[],"opening":{"absent":true},"ending":{"absent":true}},{"id":"kodik-767","dubId":"767","label":"SHIZA Project","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-10088","translationId":"767","url":"https://kodikplayer.com/seria/293353/d0598fcacc6b0f290d9ac26b6e5716e1/720p","season":1,"ordinal":12}},{"id":"kodik-610","dubId":"610","label":"AniLibria.TV","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-10349","translationId":"610","url":"https://kodikplayer.com/seria/298629/ca1d487821fb752d075eee32a7a9c204/720p","season":1,"ordinal":12}},{"id":"kodik-609","dubId":"609","label":"AniDUB","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-10111","translationId":"609","url":"https://kodikplayer.com/seria/307864/7850c73c6d0bfbdfa20e8a4c233a0a9f/720p","season":1,"ordinal":12}}],"season":1,"ordinal":12}],"translations":{"en":["Libra of Nil Admirari","The Taishou era didn’t end in 15 years, but went on for another 25.\n\n\n\nIn order to protect her waning family, a girl resolves to marry a man she doesn’t even know the name of. However, just before the marriage was to take place, the girl’s younger brother mysteriously committed suicide by self-immolation and was found holding an old book in his hands.\n\n\n\nAppearing before the bewildered young girl was the “Imperial Library Intelligence Asset Management Bureau”- more commonly referred to as “Fukurou”.\n\n\n\nAccording to these men, there exists “Maremono”, which are books that greatly affects its readers. On top of that, ever since the incident involving the girl’s younger brother, she unwittingly gains the ability to see “Auras” (the sentiments of the Maremono which manifest as bright lights and are usually invisible to humans). It was as though fate were trying to drag the young girl in its flames.\n\n\n\nAnd then, even though apprehensive, the girl chooses to venture outside her bird cage.\n\n\n\nJealousy, hatred, scorn, compassion and love.\nWhat awaited the girl was the darkness of betrayal that had already begun to bewitchingly inlay the imperial capital.\n\n\n\nToyed by and swayed within that darkness, will the young girl finally reach the truth after her struggles, or…?\n\n\n\n(Source: VNDB)"],"ja":["ニル・アドミラリの天秤",""]},"kodikRevisions":{"serial-10088":"2019-12-13T22:34:17Z","serial-10349":"2019-11-23T15:08:08Z","serial-10111":"2018-07-18T07:39:26Z"},"kodikIds":["serial-10088","serial-10349","serial-10111"],"relatedMalIds":[],"availableEpisodeCount":12,"rating":6.67}]}