bsent":true},"ending":{"absent":true}},{"id":"kodik-4119","dubId":"4119","label":"DS Triangle","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-74053","translationId":"4119","url":"https://kodikplayer.com/seria/1588615/dd10a4cadb31384d7ac97990835e2931/720p","season":1,"ordinal":13}},{"id":"kodik-869","dubId":"869","label":"Субтитры","language":"ja","original":true,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-21239","translationId":"869","url":"https://kodikplayer.com/seria/678513/62ea6c25122f0804300386300aa3fc10/720p","season":1,"ordinal":13}},{"id":"kodik-767","dubId":"767","label":"SHIZA Project","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-37298","translationId":"767","url":"https://kodikplayer.com/seria/914519/893621fe04e02a0aa95478797e1de7d8/720p","season":1,"ordinal":13}}],"season":1,"ordinal":13}],"translations":{"en":["pet","What if someone was able to reach into your mind and change your memories? To alter your perceptions, see things that aren't there, and remember events that never happened? You could drive off a cliff believing that you were still on the road, or commit murder without knowing what you had done. Now imagine being one of the people born with this ability. Knowing how easily our entire world can be taken apart, would you accept orders to manipulate others?\n\n\n\nThat's the conundrum that Hiroki, Satoru and Tsukasa find themselves in as they're employed as psychic hitmen and enforcers by a mysterious agency. Or, at least, that's what might be happening. Because they themselves are almost certainly being manipulated, and the concepts of truth and reality cease to have meaning when you're one of the terrifying beings known as a pet.\n\n\n\n(Source: Sentai Filmworks)"],"ja":["pet",""]},"kodikRevisions":{"serial-74053":"2026-04-05T06:38:41Z","serial-21239":"2020-06-30T20:54:26Z","serial-37298":"2021-11-03T05:09:59Z"},"kodikIds":["serial-74053","serial-21239","serial-37298"],"relatedMalIds":[],"rating":6.45,"availableEpisodeCount":13}]}