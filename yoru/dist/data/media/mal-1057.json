{"policyVersion":3,"items":[{"translations":{"en":["",""],"ja":["",""]},"airedAt":null,"relations":[],"id":"mal-1057","ids":{"shikimori":1057,"mal":1057,"anilist":null,"kodik":"serial-53277"},"kodikIds":["serial-28489","serial-53277"],"kodikRevisions":{"serial-28489":"2020-08-07T23:45:24Z","serial-53277":"2023-08-21T13:42:50Z"},"title":"Мисс Критические Дни","originalTitle":"Ippatsu Kikimusume","alt":"イッパツ危機娘","description":"Куньян — живое воплощение неудачи, постоянно страдающая от критического невезения, которое распространяется и на неё саму, и даже на её подруг. Постоянно стоя на краю смерти, в самых нелепых ситуациях она отчаянно борется за жизнь, а мы наблюдаем за этим вместе с научным консультантом, который каждый раз описывает все нюансы происходящего и влияющие на наблюдаемые события силы физики, химии и биологии. Общей задумки у сериала нет, но есть ряд мало связанных друг с другом эпизодов из жизни несчастной Куньян, каждый из которых описывает границы возможного для человеческого тела, в которые должна уложиться Куньян, чтобы выжить.","year":1999,"type":"TV","genres":["Экшен","Комедия","этти"],"rating":6.18,"popularity":0,"ongoing":false,"relatedMalIds":[],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/1057/3a3ab6627ae4188bc8d9238d99f6eb93.jpeg","width":670,"height":910},"backdrop":{"url":"https://shikimori.io/system/screenshots/original/6b65a50519130e46df24a7360ec9624cbcded3c9.jpg","width":629,"height":472}},"releasedEpisodes":[16],"episodes":[{"number":16,"ordinal":16,"season":1,"audio":[{"id":"kodik-1051","dubId":"1051","label":"Kallaider","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-28489","translationId":"1051","url":"https://kodikplayer.com/seria/701280/da62a7b70a19e89e5c76fbde69ffe337/720p","season":1,"ordinal":16}},{"id":"kodik-2476","dubId":"2476","label":"Студия LKM","language":"