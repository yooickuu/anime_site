zes his destiny.\n\n\n\n(Source: Anime News Network)"],"ja":["TEXHNOLYZE",""]},"kodikRevisions":{"serial-43772":"2022-08-09T00:43:56Z","serial-20503":"2019-12-30T03:23:56Z","serial-7964":"2017-12-29T13:49:07Z"},"kodikIds":["serial-43772","serial-20503","serial-7964"],"relatedMalIds":[],"availableEpisodeCount":22,"rating":7.76}]}