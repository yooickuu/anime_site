ria.fun/videos/media/ts/870/12/480/a9527752a7f4284d7bdc9644dd993a3e.m3u8?countryIso=KZ&isAuthorized=0&isWithVideoAds=1&isWithVideoAdsAlways=1","stream":true}],"subtitles":[],"opening":{"start":52,"end":141},"ending":{"absent":true}},{"id":"kodik-654","dubId":"654","label":"AniFilm","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-25737","translationId":"654","url":"https://kodikplayer.com/seria/648537/d51fb49be679f13ee473204d4e6626b1/720p","season":1,"ordinal":12}},{"id":"kodik-610","dubId":"610","label":"AniLibria.TV","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-8122","translationId":"610","url":"https://kodikplayer.com/seria/211111/c84525fb0e370b7c81958a8bd2c72cc5/720p","season":1,"ordinal":12}}],"season":1,"ordinal":12}],"translations":{"en":["Love, Chunibyo & Other Delusions","Everybody has had that stage in their life where they have thought themselves to be special, different from the masses of ordinary humans. They might go as far as seeing themselves capable of wielding mystical powers, or maybe even believe themselves to have descended from a fantasy realm. This \"disease\" is known as \"chuunibyou\" and is often the source of some of the most embarrassing moments of a person's life.\n\n\n\nFor Yuuta Togashi, the scars that his chuunibyou has left behind are still fresh. Having posed as the \"Dark Flame Master\" during his middle school years, he looks back at those times with extreme embarrassment, so much so that he decides to attend a high school far away where nobody will recognize him. Putting his dark history behind him, he longs to live a normal high school life.\n\n\n\nUnfortunately, he hasn't escaped his past yet: enter Rikka Takanashi, Yuuta's new classmate and self-declared vessel of the \"Wicked Eye.\" As this eccentric young girl crashes into Yuuta's life, his dream of an ordinary, chuunibyou-free life quickly crumbles away. In this hilarious and heartwarming story of a boy who just wants to leave his embarrassing memories behind, the delusions of old are far from a thing of the past.\n\n\n\n(Source: MAL Rewrite)"],"ja":["中二病でも恋がしたい!",""]},"kodikRevisions":{"serial-25737":"2020-05-16T14:39:01Z","serial-8122":"2019-12-11T22:50:18Z","serial-41779":"2026-10-09T13:19:08Z"},"kodikIds":["serial-25737","serial-8122","serial-41779"],"relatedMalIds":[16934],"rating":7.7,"relations":[{"id":16934,"relation":"sequel"}],"availableEpisodeCount":13}]}