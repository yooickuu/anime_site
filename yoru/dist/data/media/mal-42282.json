/13/1080/56969649207734924e719d2144b62969.m3u8?countryIso=KZ&isAuthorized=0&isWithVideoAds=1&isWithVideoAdsAlways=1","stream":true},{"quality":720,"url":"https://cache-rfn.libria.fun/videos/media/ts/9007/13/720/e1bca9c9e55e04dc9fcf43d1a7fe87fa.m3u8?countryIso=KZ&isAuthorized=0&isWithVideoAds=1&isWithVideoAdsAlways=1","stream":true},{"quality":480,"url":"https://cache-rfn.libria.fun/videos/media/ts/9007/13/480/25fe18aabc82de4b83fa4d81369e010f.m3u8?countryIso=KZ&isAuthorized=0&isWithVideoAds=1&isWithVideoAdsAlways=1","stream":true}],"subtitles":[],"opening":{"start":1,"end":90},"ending":{"absent":true}}],"season":2,"ordinal":13}],"translations":{"en":["My Next Life as a Villainess: All Routes Lead to Doom! X","Katarina Claes, the daughter of a duke, regains her memories from a previous life after hitting her head on a rock. The world she lives in now is the world of Fortune Lover, the otome game she was hooked on in her previous life, and she is now the villainess who interferes with the heroine's love story! The happy ending prepared for Katarina in the game is being exiled from the country, and the bad ending, she gets killed... but she's determined to avoid all destruction flags and claim a happy future for herself! And after she succeeds in avoiding those flags, a new crisis awaits?! The curtain rises once again on this flirtatious romantic comedy!\n\n\n\n(Source: Crunchyroll)"],"ja":["乙女ゲームの破滅フラグしかない悪役令嬢に転生してしまった…Ｘ",""]},"kodikRevisions":{"serial-35986":"2024-05-25T22:17:08Z","serial-35585":"2021-09-23T18:03:59Z","serial-35971":"2022-03-27T05:09:16Z"},"kodikIds":["serial-35986","serial-35585","serial-35971"],"relatedMalIds":[38555,49842],"rating":7.25,"relations":[{"id":38555,"relation":"prequel"},{"id":49842,"relation":"sequel"}],"availableEpisodeCount":13}]}