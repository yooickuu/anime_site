{"policyVersion":3,"items":[{"translations":{"en":["",""],"ja":["",""]},"airedAt":null,"relations":[],"id":"mal-1337","ids":{"shikimori":1337,"mal":1337,"anilist":null,"kodik":"serial-48604"},"kodikIds":["serial-48604"],"kodikRevisions":{"serial-48604":"2023-08-21T16:52:11Z"},"title":"Дьявольский принц Энма","originalTitle":"Dororon Enma-kun","alt":"Доророн Энма-кун / Дьявольский принц Энма / The Little Judge from Hell","description":"Чудовища проникают в мир людей из Ада, чтобы охотиться на человеческие души. Людские помыслы становятся всё грязнее, и, привлечённые этой скверной, монстры нарушают запрет и являются в мир людей. Цутому, мальчик, учащийся в Ёкай-начальной школе, внезапно подвергается нападению чудовищ. Спасают его Энма-кун — сын самого Энмы, снежная женщина Юкико и Капаэру. Все они состоят в Патруле монстров — отряде, который отправляют в мир людей для поимки нарушителей.","year":1973,"type":"TV","genres":["Сёнен","Комедия","Ужасы","Сверхъестественное","мифология"],"rating":6.51,"popularity":0,"ongoing":false,"relatedMalIds":[],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/1337/80544aecbca3872afacc51e4a052d666.jpeg","width":705,"height":995},"backdrop":{"url":"https://shikimori.io/uploads/poster/animes/1337/80544aecbca3872afacc51e4a052d666.jpeg","width":705,"height":995}},"releasedEpisodes":[1,2],"episodes":[{"number":1,"ordinal":1,"season":1,"audio":[{"id":"kodik-827","dubId":"827","label":"Persona99","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-48604","translationId":"827","url":"https://kodikplayer.com/seria/1099342/ab55b80f29b7d9a77053c636c7c01472/720p","season":1,"ordinal":1}}]},{"number":2,"ordinal":2,"season":1,"audio":[{"id":"kodik-827","dubId":"827","label":"Persona99","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"val