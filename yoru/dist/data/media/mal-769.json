{"policyVersion":3,"items":[{"translations":{"en":["",""],"ja":["",""]},"airedAt":null,"relations":[],"id":"mal-769","ids":{"shikimori":769,"mal":769,"anilist":null,"kodik":"serial-21039"},"kodikIds":["serial-21039"],"kodikRevisions":{"serial-21039":"2020-01-11T19:01:27Z"},"title":"Разгон! Дубль-вэ","originalTitle":"Burn Up W","alt":"Разгон! Дубль-вэ ОВА / Burn Up! W OVA","description":"Когда преступники заполоняют улицы футуристического Токио, а полиция ничего не может с этим поделать, на сцену выходит спецотряд \"Воители\". Знакомьтесь - грудастая блондинка-штурмовик Рио Кинезоно, гениальная хакерша из богатой семьи Лилика Эберт и снайпер Майя Джингу, которая жить не может без того, чтобы не пострелять в кого-нибудь. Это чокнутое трио и преступника на скаку задержит, и в горящий небоскрёб войдёт, и половину города разнесёт к чертям. Пристегните ремни, дамы и господа, на очереди у нас симфония разрушения с аккомпанементом из прыгающих грудей!","year":1996,"type":"OVA","genres":["Комедия","Фантастика","этти","меха"],"rating":6.43,"popularity":0,"ongoing":false,"relatedMalIds":[],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/769/2a56342a6e48e5b7740c950f427f117c.jpeg","width":281,"height":400},"backdrop":{"url":"https://shikimori.io/system/screenshots/original/d1c6a76fcb02fe71037676333f2ff86fddcd9615.jpg","width":640,"height":488}},"releasedEpisodes":[1,2,3,4],"episodes":[{"number":1,"ordinal":1,"season":1,"audio":[{"id":"kodik-609","dubId":"609","label":"AniDUB","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-21039","translationId":"609","url":"https://kodikplayer.com/seria/556098/a9c60892fbfb3115c947e817158013bf/720p","season":1,"ordinal":1}}]},{"number":2,"ordinal":2,"season":1,"audio":[{"id":"kodik-609","dubId":"609","label":"AniDUB","language":"ru","original":false,"duration":null,"sources":[],"subti