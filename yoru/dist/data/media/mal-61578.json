btitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-78608","translationId":"1525","url":"https://kodikplayer.com/seria/1681989/e9a904eff05626f1158736c62665caf5/720p","season":1,"ordinal":3}},{"id":"kodik-2822","dubId":"2822","label":"AniBaza","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-78737","translationId":"2822","url":"https://kodikplayer.com/seria/1681880/bc32cbde82814708a4b0f491966c8180/720p","season":1,"ordinal":3}},{"id":"kodik-557","dubId":"557","label":"JAM","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-78707","translationId":"557","url":"https://kodikplayer.com/seria/1681698/b73681c32e33548c815ceb5fc8855352/720p","season":1,"ordinal":3}}]}],"translations":{"en":["Even the Student Council Has Its Holes!","This is Fujinasu Academy, a private high school with top-achieving students located on the outskirts of town.\n\n\n\nHigh School 1st-Year Ume Mizunoe has excellent grades in Japanese language class and has received multiple literary awards.\nHowever, his terrible grades in the sciences are affecting his ability to move up a grade. To avoid repeating a year, he becomes a member of the student council to improve his academic standing.\n\n\n\nHowever, in the student council, he meets the charismatic yet sullen student council president Kotobuki Hisako, and the scary yet kind and refined treasurer, Arisu Terui. Other members include a cheeky and cute boy, Tan Otori, and Komaro Michinoku, the admin who's like a small abandoned cat. This is the start of a slapstick, heartful, rom-com about a busy student council full of cute, mismatched, and quirky students!\n\n\n\n(Source: Even the Student Council Has Its Holes! Official Site)"],"ja":["生徒会にも穴はある！",""]}}]}