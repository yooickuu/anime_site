1&isWithVideoAdsAlways=1","stream":true},{"quality":480,"url":"https://cache-rfn.libria.fun/videos/media/ts/10053/12/480/7283aa84919014bbfb459e46c2d2be05.m3u8?countryIso=KZ&isAuthorized=0&isWithVideoAds=1&isWithVideoAdsAlways=1","stream":true}],"subtitles":[],"opening":{"start":103,"end":193},"ending":{"start":1351,"end":1440}},{"id":"kodik-3677","dubId":"3677","label":"NextVoice","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-70627","translationId":"3677","url":"https://kodikplayer.com/seria/1550239/de58fd749e12aa67a90d0da3e1fc9e34/720p","season":1,"ordinal":12}},{"id":"kodik-2491","dubId":"2491","label":"Kazoku Project","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-70669","translationId":"2491","url":"https://kodikplayer.com/seria/1553152/cc52279c0d8aba6a32685b6d2e983fc8/720p","season":1,"ordinal":12}},{"id":"kodik-1978","dubId":"1978","label":"Dream Cast","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-70649","translationId":"1978","url":"https://kodikplayer.com/seria/1552420/29c201399cd7e51e807df19e93e85b50/720p","season":1,"ordinal":12}}],"season":1,"ordinal":12}],"translations":{"en":["GINTAMA - Mr. Ginpachi's Zany Class","Sakata Ginpachi is a high-school teacher with his trademark silver, curly hair, dead-fish eyes, and sloppily worn lab coat.\nHe's in charge of Gintama High School's Class 3-Z: home to a ragtag group of frequent troublemakers including idol otaku, hurloines, stalkers, mayo guzzlers, sadists, delinquents, and many more.\n\n\n\nIf you thought this roller-coaster life would have Ginpachi holding his head in his hands, you thought wrong, as he nonchalantly resolves any trouble that comes his way. And if you thought this unique group of students would overcome adversity and come together as one, you thought wrong again, as they continue to raise hell!\n\n\n\n\"Oh, come on! Can 3-Z get any more ungovernable?!\"\n\n\n\nYou can never tell what this atypical teacher is thinking and he never seems up for the task, but he always comes through when it counts. He and his students star in this school-life comedy full of laughs, tears, and the whole kitchen sink!\nForget nerds, forget jocks, and come enjoy the kind of youthful days that only Gintama could ever deliver!\n\n\n\n(Source: Crunchyroll) \n\n\n\nNote: Announced at the the \"Gintama Ato no Matsuri 2023\" event."],"ja":["3年Z組銀八先生",""]},"kodikRevisions":{"serial-70627":"2026-01-06T12:16:17Z","serial-70669":"2025-12-31T06:50:21Z","serial-70649":"2025-12-28T20:30:39Z"},"kodikIds":["serial-70627","serial-70669","serial-70649"],"relatedMalIds":[],"rating":7.63}]}