zing Dubbing","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"movie-82388","translationId":"963","url":"https://kodikplayer.com/video/82388/63cca012acd9984ecc0c1891226339bd/720p","season":1,"ordinal":1}}]}],"translations":{"en":["A Silent Voice","After transferring into a new school, a deaf girl, Shouko Nishimiya, is bullied by the popular Shouya Ishida. As Shouya continues to bully Shouko, the class turns its back on him. Shouko transfers and Shouya grows up as an outcast. Alone and depressed, the regretful Shouya finds Shouko to make amends.\n\n\n\n(Source: Eleven Arts)"],"ja":["聲の形",""]},"availableEpisodeCount":1}]}