{"policyVersion":3,"items":[{"translations":{"en":["",""],"ja":["",""]},"airedAt":null,"relations":[],"id":"mal-1430","ids":{"shikimori":1430,"mal":1430,"anilist":null,"kodik":"movie-36678"},"kodikIds":["movie-36054","movie-36678"],"kodikRevisions":{"movie-36054":"2019-04-30T23:35:39Z","movie-36678":"2019-05-09T17:13:41Z"},"title":"Люпен III: Замок Калиостро","originalTitle":"Rupan sansei: Kariosutoro no shiro","alt":"Люпен III: Замок Калиостро (фильм второй)","description":"После удачного ограбления казино Арсен Люпен III понимает, что украденные деньги фальшивые. Следуя по пятам фальшивомонетчиков, Люпен и его напарник Дзигэн оказываются втянутыми в погоню за сбежавшей невестой. Люпен, как настоящий джентльмен, решает помочь бедной девушке. Вскоре он узнаёт в ней свою старую знакомую, наследницу рода Калиостро, которую глава второй ветви пытается заставить выйти за него замуж, чтобы получить сокровища. Ни минуты не думая, Люпен ввязывается в авантюру по спасению невесты из замка Калиостро, наполненном прислужниками графа, Интерполом, и, конечно, дело не обошлось без несравненного инспектора Дзэнигаты .","year":1979,"type":"MOVIE","genres":["сэйнэн","Экшен","Приключения","Комедия","тайна","удостоено наград","взрослые персонажи"],"rating":8.16,"popularity":0,"ongoing":false,"relatedMalIds":[],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/1430/739d48132035e69a9d11759b0b3a19e7.jpeg","width":695,"height":995},"backdrop":{"url":"https://shikimori.io/system/screenshots/original/d325db8e98ec740f71691e213ef75feef7f03894.jpg","width":1920,"height":1080}},"releasedEpisodes":[1],"episodes":[{"number":1,"ordinal":1,"season":1,"audio":[{"id":"kodik-734","dubId":"734","label":"Проф. Многоголосый","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"movie-36054","translationId":"734","url":"https://kodikplayer.com/video/36054/3e