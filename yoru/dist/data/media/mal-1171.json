{"policyVersion":3,"items":[{"translations":{"en":["",""],"ja":["",""]},"airedAt":null,"relations":[],"id":"mal-1171","ids":{"shikimori":1171,"mal":1171,"anilist":null,"kodik":"serial-22951"},"kodikIds":["serial-22949","serial-22950","serial-22951"],"kodikRevisions":{"serial-22949":"2020-02-19T15:11:25Z","serial-22950":"2020-02-19T15:12:55Z","serial-22951":"2020-02-19T15:14:05Z"},"title":"Превосходные Рубаки","originalTitle":"Slayers Excellent","alt":"Превосходные Рубаки","description":"История повествует о первой встрече Лины Инверс и Наги Серпент . В первом эпизоде волшебницы, вынужденные работать вместе, чтобы помочь деревне, сталкиваются лицом к лицу с вампиром. Во втором эпизоде Лину наняли сопровождать Сирену , дочку богатого торговца. После того, как та растратила половину награды Лины , волшебница решила проучить Сирену и устроить фальшивое похищение. Однако Сирену похищают по-настоящему... В третьем эпизоде Лина и Нага вовлечены в борьбу двух дизайнеров, и каждый из них хочет, чтобы нанятая им волшебница уничтожила магазин оппонента.","year":1998,"type":"OVA","genres":["Приключения","Комедия","Фэнтези"],"rating":7.3,"popularity":0,"ongoing":false,"relatedMalIds":[],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/1171/b0ba154cb11c0354e8e895fc7b8389e5.jpeg","width":225,"height":350},"backdrop":{"url":"https://shikimori.io/system/screenshots/original/b7593f646906bb37ea5945255c15fbf14e7356b9.jpg","width":1920,"height":1080}},"releasedEpisodes":[1,2,3],"episodes":[{"number":1,"ordinal":1,"season":2,"audio":[{"id":"kodik-827","dubId":"827","label":"Persona99","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-22949","translationId":"827","url":"https://kodikplayer.com/seria/591669/3f933261d6d463c35bd77e10edd96285/720p","season":2,"ordinal":1}},{"id":"kodik-1182","dubId":"1182","label":"Лапшин","language":