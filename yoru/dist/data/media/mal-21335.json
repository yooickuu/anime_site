{"policyVersion":3,"items":[{"translations":{"en":["Double Circle","\"Double Circle\" means the community which evolves infinitely by the energy and ICT in the smart community project.\n\nPeople who live in Kawasaki become a hero, and beat an enemy who steals near from the time-stopped world to the evolving town Kawasaki.\n\n\n\n(Source: Official website)"],"ja":["ダブルサークル",""]},"airedAt":null,"relations":[],"id":"mal-21335","ids":{"shikimori":21335,"mal":21335,"anilist":20532,"kodik":"serial-25768"},"kodikIds":["serial-22201","serial-25768"],"kodikRevisions":{"serial-22201":"2020-02-01T18:51:23Z","serial-25768":"2020-05-17T10:46:03Z"},"title":"Два звена","originalTitle":"Double Circle","alt":"Два звена ダブルサークル","description":"«Два звена» — это сообщество, которое бесконечно развивается благодаря энергии и информационным технологиям в рамках проекта «умного сообщества». Жители Кавасаки становятся героями и дают отпор врагу, который крадёт время, — чтобы защитить постоянно развивающийся город Кавасаки от превращения в мир, застывший во времени.","year":2013,"type":"ONA","genres":["Фантастика","супер сила"],"rating":4.82,"popularity":1683,"ongoing":false,"relatedMalIds":[],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/21335/7f907d6ae8fd72e285336031c8bc6b85.jpeg","width":700,"height":995},"backdrop":{"url":"https://shikimori.io/system/screenshots/original/f17f355e8a91469997dc84a14750461b03ad1058.jpg","width":1280,"height":720}},"releasedEpisodes":[1,2,3,4,5,6],"episodes":[{"number":1,"ordinal":1,"season":1,"audio":[{"id":"kodik-767","dubId":"767","label":"SHIZA Project","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-22201","translationId":"767","url":"https://kodikplayer.com/seria/576356/209d5b2f806545621bf5bfc4e90209b1/720p","season":1,"ordinal":1}},{"id":"kodik-654","dubId":"654","label":"AniFilm","langu