ways=1","stream":true}],"subtitles":[],"opening":{"absent":true},"ending":{"absent":true}},{"id":"kodik-1631","dubId":"1631","label":"Indie Dub","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-67178","translationId":"1631","url":"https://kodikplayer.com/seria/1473923/4af89ab3274c16a1571b13e89f91bcc2/720p","season":1,"ordinal":13}},{"id":"kodik-610","dubId":"610","label":"AniLibria.TV","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-5572","translationId":"610","url":"https://kodikplayer.com/seria/149058/2922bc54ca6d6aa8fafc16b8b2837ccc/720p","season":1,"ordinal":13}},{"id":"kodik-767","dubId":"767","label":"SHIZA Project","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-21490","translationId":"767","url":"https://kodikplayer.com/seria/564206/f254c07f81dd2f963cd66272c15f3b39/720p","season":1,"ordinal":13}}],"ordinal":13}],"translations":{"en":["Gargantia on the Verdurous Planet","The story begins in the distant future in the far reaches of the galaxy. The Human Galactic Alliance has been constantly fighting for its survival against a grotesque race of beings called \"Hidiaazu.\" During an intense battle, the young lieutenant Ledo and his humanoid mobile weapon Chamber are swallowed up into a distortion of time and space. Waking from his artificially induced hibernation, Ledo realizes that he has arrived on Earth, the planet on the lost frontier. On this planet that was completely flooded by the seas, people live in fleets of giant ships, salvaging relics from the seas' depths in order to survive. Ledo arrives on one of the fleets called Gargantia. With no knowledge of the planet's history or culture, he is forced to live alongside Amy, a 15-year-old girl who serves as a messenger aboard the Gargantia fleet. To Ledo, who has lived a life where he knows nothing but fighting, these days of peace continue to surprise him.\n\n\n\n(Source: Anime News Network)"],"ja":["翠星のガルガンティア",""]},"kodikRevisions":{"serial-67178":"2025-09-06T11:01:57Z","serial-5572":"2020-08-07T10:35:42Z","serial-21490":"2020-01-20T17:32:59Z"},"kodikIds":["serial-67178","serial-5572","serial-21490"],"relatedMalIds":[19211],"rating":7.44,"relations":[{"id":19211,"relation":"sequel"}],"availableEpisodeCount":15}]}