{"policyVersion":3,"items":[{"translations":{"en":["",""],"ja":["",""]},"airedAt":null,"relations":[],"id":"mal-3913","ids":{"shikimori":3913,"mal":3913,"anilist":null,"kodik":"serial-28741"},"kodikIds":["serial-28741"],"kodikRevisions":{"serial-28741":"2020-08-17T08:23:11Z"},"title":"Истребитель демонов","originalTitle":"Onikirimaru","alt":"Ogre Slayer","description":"Давным-давно родился чистокровный демон с внешностью человека. Вместо рога людоеда ребёнок с рождения обладал мечом, способным уничтожить весь его род. Монстр желал стать человеком, поэтому решил уничтожить всех демонов-собратьев, веря в то, что только так сможет достичь заветной мечты. Он веками скитается по городам и деревням Японии, убивая всех демонов, с которыми сталкивается. Поскольку у него нет собственного имени, он известен по имени своего меча — Оникиримару .","year":1994,"type":"OVA","genres":["Сёнен","Экшен","Ужасы","Сверхъестественное","жестокост","боевые искусства","мифология"],"rating":6.4,"popularity":0,"ongoing":false,"relatedMalIds":[],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/3913/da5bc32abf02628969a70c85d2a44952.jpeg","width":430,"height":600},"backdrop":{"url":"https://shikimori.io/system/screenshots/original/b1790237f1fae6b1c4bc110ca9149456a73f2cc5.jpg","width":640,"height":480}},"releasedEpisodes":[1,2,3,4],"episodes":[{"number":1,"ordinal":1,"season":1,"audio":[{"id":"kodik-820","dubId":"820","label":"animereactor","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-28741","translationId":"820","url":"https://kodikplayer.com/seria/706234/a05ba03f7c134ffca7cee429409ee43a/720p","season":1,"ordinal":1}}]},{"number":2,"ordinal":2,"season":1,"audio":[{"id":"kodik-820","dubId":"820","label":"animereactor","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation