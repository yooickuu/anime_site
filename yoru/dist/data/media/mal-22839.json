{"policyVersion":3,"items":[{"id":"mal-22839","ids":{"mal":22839,"shikimori":22839,"anilist":20831,"anilibria":1400,"kodik":"movie-117036"},"title":"Перепутье","originalTitle":"Cross Road","alt":"Перепутье Cross Road Cross Road","year":2014,"type":"ONA","genres":["Повседневность","Школа"],"description":"Старшеклассники Михо и Сёта решили поступать в Токийский университет и готовятся к вступительным экзаменам. Михо обитает на острове, где нет никаких подготовительных курсов, в то время как Сёта живёт в Токио и подрабатывает на полставки. Они стремятся и стараются изо всех сил. Оба записываются на дистанционные подготовительные курсы в группе Z. И в этот момент их жизни пересекаются прежде, чем они сами это понимают.","ongoing":false,"releasedEpisodes":[1],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/22839/b9f01255d4654510b141a3881bcc73b9.jpeg","width":735,"height":980},"backdrop":{"url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/20831-Fptaf1xbgELR.png","width":1720,"height":485}},"episodes":[{"number":1,"audio":[{"id":"anilibria","dubId":"AniLibria","label":"AniLibria (RU)","language":"ru","original":false,"duration":119,"sources":[{"quality":720,"url":"https://cache-rfn.libria.fun/videos/media/ts/1400/1/720/f183a889aa9db0a778ddc4b79953e1fb.m3u8?countryIso=KZ&isAuthorized=0&isWithVideoAds=1&isWithVideoAdsAlways=1","stream":true},{"quality":480,"url":"https://cache-rfn.libria.fun/videos/media/ts/1400/1/480/c4e04d56c03ab5981a348b9c21bd2d8e.m3u8?countryIso=KZ&isAuthorized=0&isWithVideoAds=1&isWithVideoAdsAlways=1","stream":true}],"subtitles":[],"opening":{"absent":true},"ending":{"absent":true}},{"id":"kodik-3605","dubId":"3605","label":"Подвал Мурой","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"movie-119461","translationId":"3605","url":"https://kodikplayer.com/video/119461/40a063d6c9031cb2439e