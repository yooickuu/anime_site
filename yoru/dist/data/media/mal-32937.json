m":true,"checkedAt":"2026-10-23T15:45:20.791Z"},{"quality":360,"url":"https://cloud.solodcdn.com/useruploads/0ad01429-0692-4162-a2da-dcc09d8b6b65/6a12f37c1074675d26e5f0b88eccffd6:2026102403/360.mp4:hls:manifest.m3u8","stream":true,"checkedAt":"2026-10-23T15:45:20.801Z"}],"subtitles":[],"opening":null,"ending":null,"providerRef":{"provider":"kodik","releaseId":"serial-44888","translationId":"1467","url":"https://kodikplayer.com/seria/1036592/d6d52d74057c1f01968df90b628aae0d/720p","season":2,"ordinal":10},"validation":"provider-link"},{"id":"kodik-1863","dubId":"1863","label":"КОМНАТА ДИДИ","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-65308","translationId":"1863","url":"https://kodikplayer.com/seria/1453816/6d31463747197082f939730b673345b9/720p","season":2,"ordinal":10}},{"id":"kodik-1811","dubId":"1811","label":"OnWave","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-73457","translationId":"1811","url":"https://kodikplayer.com/seria/1574993/94a3d59d98fcfb2046eb18b79b5ed898/720p","season":2,"ordinal":10}}]}],"translations":{"en":["KONOSUBA -God's blessing on this wonderful world! 2","When Kazuma Satou died, he was given two choices: pass on to heaven or be revived in a fantasy world. After choosing the new world, the goddess Aqua tasked him with defeating the Demon King, and let him choose any weapon to aid him. Unfortunately, Kazuma chose to bring Aqua herself and has regretted the decision ever since then.\n\n\n\nNot only is he stuck with a useless deity turned party archpriest, the pair also has to make enough money for living expenses. To add to their problems, their group continued to grow as more problematic adventurers joined their ranks. Their token spellcaster, Megumin, is an explosion magic specialist who can only cast one spell once per day and refuses to learn anything else. There is also their stalwart crusader, Lalatina \"Darkness\" Dustiness Ford, a helpless masochist who makes Kazuma look pure in comparison.\n\n\n\nKono Subarashii Sekai ni Shukufuku wo! 2 continues to follow Kazuma and the rest of his party through countless more adventures as they struggle to earn money and have to deal with one another's problematic personalities. However, things rarely go as planned, and they are often sidetracked by their own idiotic tendencies."],"ja":["この素晴らしい世界に祝福を！2",""]},"relations":[{"id":30831,"relation":"prequel"},{"id":38040,"relation":"sequel"}],"availableEpisodeCount":10}]}