{"policyVersion":3,"items":[{"translations":{"en":["",""],"ja":["",""]},"airedAt":null,"relations":[],"id":"mal-1734","ids":{"shikimori":1734,"mal":1734,"anilist":null,"kodik":"serial-27226"},"kodikIds":["serial-27226"],"kodikRevisions":{"serial-27226":"2020-06-28T16:40:27Z"},"title":"Адзиму: Пляжная история","originalTitle":"Ajimu: Kaigan Monogatari","alt":"あじむ 〜海岸物語〜","description":"Семнадцатилетний Накайдо Хиросукэ Накайдо — самый obычный старшеклассник. Однажды утром, направляясь на станцию по пути в школу, он замечает прекрасную девушку по имени Адзиму Ясуна Ясуна и сразу же влюбляется в неё. Молодые люди знакомятся и становятся друзьями, но парень никак не решается признаться в своих чувствах, а сама Ясуна пока не разобралась в собственных. Пока различные события и посторонние люди создают препятствия на пути к возможному счастью, отношения между героями постепенно развиваются, а их чувства становятся всё яснее.","year":2001,"type":"ONA","genres":["Комедия","Драма","Романтика","Музыка","Школа"],"rating":6.33,"popularity":0,"ongoing":false,"relatedMalIds":[],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/1734/8d707b19e44f8115c51add0411e4be0b.jpeg","width":300,"height":425},"backdrop":{"url":"https://shikimori.io/system/screenshots/original/380d0e66435a936398a6cfee4c5e2d8ff6c30e44.jpg","width":960,"height":720}},"releasedEpisodes":[1,2,3,4],"episodes":[{"number":1,"ordinal":1,"season":1,"audio":[{"id":"kodik-999","dubId":"999","label":"OpenDub","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-27226","translationId":"999","url":"https://kodikplayer.com/seria/676945/bf385d0032b5c31e672de5544f1985da/720p","season":1,"ordinal":1}}]},{"number":2,"ordinal":2,"season":1,"audio":[{"id":"kodik-999","dubId":"999","label":"OpenDub","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"ope