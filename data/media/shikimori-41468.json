":true},{"quality":720,"url":"https://cache-rfn.libria.fun/videos/media/ts/8842/3/720/c92d787657caeb1766355e5c836e95ec.m3u8?countryIso=KZ&isAuthorized=0&isWithVideoAds=1&isWithVideoAdsAlways=1","stream":true},{"quality":480,"url":"https://cache-rfn.libria.fun/videos/media/ts/8842/3/480/8be5e3217611df99ac87f03d09245dc4.m3u8?countryIso=KZ&isAuthorized=0&isWithVideoAds=1&isWithVideoAdsAlways=1","stream":true}],"subtitles":[],"opening":{"absent":true},"ending":{"absent":true}},{"id":"kodik-3297","dubId":"3297","label":"CalliopeHouse","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-59573","translationId":"3297","url":"https://kodikplayer.com/seria/1344844/c5fa920ae569187bc82299dcda3b2976/720p","season":1,"ordinal":3}},{"id":"kodik-2458","dubId":"2458","label":"AniBoom.Subtitles","language":"ja","original":true,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-46918","translationId":"2458","url":"https://kodikplayer.com/seria/1075584/e638a5e02c017f35b4e9d2a3175c57f0/720p","season":1,"ordinal":3}},{"id":"kodik-2835","dubId":"2835","label":"Silver AniAge","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-53165","translationId":"2835","url":"https://kodikplayer.com/seria/1220169/8d4f35662becf8f8684795dfba0d8716/720p","season":1,"ordinal":3}}],"season":1,"ordinal":3}],"translations":{"en":["BURN THE WITCH","Historically, 72% of all the deaths in London are related to dragons, fantastical beings invisible to the majority of the people. While unknown to most, some people have been standing up to these dragons.\n\n\n\nOnly inhabitants of Reverse London who live in the hidden \"reverse\" side of London can see the dragons. Even then, only a selected few become qualified enough as witches or wizards to make direct contact with them.\n\n\n\nThe protagonists of the story are witch duo Noel Niihashi and Ninny Spangcole. They are protection agents for Wing Bind (WB), an organization for dragon conservation and management. Their mission is to protect and manage the dragons within London on behalf of the people.\n\n\n\n(Source: Official Site)\n\n\nNote: The show was screened in theaters and released online on the same date; the theatrical release combines all three episodes into one."],"ja":["BURN THE WITCH",""]},"kodikRevisions":{"serial-59573":"2024-08-19T20:36:12Z","serial-46918":"2022-11-24T17:55:57Z","serial-53165":"2023-10-16T14:59:07Z"},"kodikIds":["serial-59573","serial-46918","serial-53165"],"relatedMalIds":[56671],"rating":7.14,"relations":[{"id":56671,"relation":"prequel"}]}]}