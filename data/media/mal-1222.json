dubId":"829","label":"Animegroup","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-23115","translationId":"829","url":"https://kodikplayer.com/seria/596451/812733f9b518f59b1916ec877b535d02/720p","season":1,"ordinal":26}}],"season":1,"ordinal":26}],"translations":{"en":["We Were There","Nanami Takahashi welcomes the start of her high school life with great expectations of making as many friends as possible. There is much talk among the girls about a popular boy, Motoharu Yano, who has 2/3 of the girls in his middle school liking him. When Nanami asks Yuri Yamamoto, the girl sitting next to her, about Yano, the latter curtly replies that she dislikes him. Nanami is clueless of who Yano is until the day of the class nomination when she made a fool of herself by calling the name of her new friend wrongly. It turns out that she has actually met Yano along the corridors (unaware of his true identity) and he tricked her by providing a random name, resulting in the embarrassing incident in class. Nanami was initially mad at Yano but after a few encounters with him, she begins to find herself liking him."],"ja":["僕等がいた",""]},"kodikRevisions":{"serial-32690":"2022-05-03T18:12:11Z","serial-27313":"2020-12-26T05:06:46Z","serial-23115":"2020-02-24T12:08:58Z"},"kodikIds":["serial-32690","serial-27313","serial-23115"],"relatedMalIds":[],"availableEpisodeCount":26,"rating":7.23}]}