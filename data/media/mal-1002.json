{"policyVersion":3,"items":[{"translations":{"en":["",""],"ja":["",""]},"airedAt":null,"relations":[],"id":"mal-1002","ids":{"shikimori":1002,"mal":1002,"anilist":null,"kodik":"serial-22987"},"kodikIds":["serial-22987"],"kodikRevisions":{"serial-22987":"2020-02-20T15:55:20Z"},"title":"Дайбастер: Дотянись до неба! 2","originalTitle":"Top o Nerae 2! Diebuster","alt":"Gunbuster 2","description":"Сюжет повествует о деревенской простодушной девушке по имени Ноно , мечтающей стать пилотом космического корабля (а если точнее, «как Нонорин»), которая благодаря случайной встрече с настоящим пилотом по имени Ларк становится членом так называемого «Братства», непростая задача которых — управляя огромными боевыми роботами, сражаться с роем космических монстров. Ноно воодушевляется примером этой смелой и самоуверенной девушки, да вдобавок начинает относиться к ней, как к старшей сестре. С таким напарником, как настоящий космический пилот, путь к заветной мечте наверняка окажется ближе.","year":2004,"type":"OVA","genres":["Комедия","Драма","Фантастика","удостоено наград","меха","космос"],"rating":7.59,"popularity":0,"ongoing":false,"relatedMalIds":[],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/1002/28f6e9e1b7f000fbf92558810c756a83.jpeg","width":710,"height":1000},"backdrop":{"url":"https://shikimori.io/system/screenshots/original/a5642c96c3daef06a9795b259527fb370b4268af.png","width":1277,"height":717}},"releasedEpisodes":[1,2,3,4,5,6],"episodes":[{"number":1,"ordinal":1,"season":2,"audio":[{"id":"kodik-818","dubId":"818","label":"Reanimedia","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-22987","translationId":"818","url":"https://kodikplayer.com/seria/592478/85d641397cd10623054791de0fc5c3c8/720p","season":2,"ordinal":1}}]},{"number":2,"ordinal":2,"season":2,"audio":[{"id":"kodik-818","dubId":"818","label":"Reanim