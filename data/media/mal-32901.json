nime News Network)"],"ja":["エロマンガ先生",""]},"kodikRevisions":{"serial-47550":"2022-12-24T13:20:39Z","serial-26987":"2020-06-19T14:44:09Z","serial-22012":"2020-01-30T21:01:11Z"},"kodikIds":["serial-47550","serial-26987","serial-22012"],"relatedMalIds":[],"availableEpisodeCount":12,"rating":6.31}]}