titles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-44161","translationId":"739","url":"https://kodikplayer.com/seria/1026210/051a82282011bcb885af09cbc7eaca4c/720p","season":1,"ordinal":12}},{"id":"kodik-1124","dubId":"1124","label":"Force Media","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-32272","translationId":"1124","url":"https://kodikplayer.com/seria/777165/554641554407143285bd5ed196cfa208/720p","season":1,"ordinal":12}},{"id":"kodik-767","dubId":"767","label":"SHIZA Project","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-21148","translationId":"767","url":"https://kodikplayer.com/seria/557976/707f33787524de3a1e5dce85f9952fa4/720p","season":1,"ordinal":12}}],"season":1,"ordinal":12}],"translations":{"en":["Kids on the Slope","The beginning of summer, 1966. \n\n\nBecause of his father's job situation, freshman high school student Kaoru Nishimi moves by himself from Yokosuka to Kyushu to live with relatives. Until then, Kaoru was an honor roll student who tended to keep to himself, but meeting notorious bad boy Sentaro Kawabuchi starts to change him. Through his devil-may-care classmate, Kaoru learns the attractions of jazz and finds the first person he can call a \"friend\". He also discovers how much fun it is to play music with a pal. \n\n\nOther characters include Sentaro's kind childhood chum, Ritsuko, who is the daughter of a record shop owner; the mysterious upperclassman, Yurika; and Brother Jun, the much-admired leader among their peers. Set against the backdrop of a seaside town with a scent of American culture, this series is a drama about young people coming into their own, crossing each other's paths, and finding friendship, love, and music! \n\n\n(Source: Official Website)"],"ja":["坂道のアポロン",""]},"kodikRevisions":{"serial-44161":"2022-07-09T03:23:07Z","serial-32272":"2021-01-28T21:51:59Z","serial-21148":"2020-01-13T14:11:54Z"},"kodikIds":["serial-44161","serial-32272","serial-21148"],"relatedMalIds":[],"availableEpisodeCount":12,"rating":8.29}]}