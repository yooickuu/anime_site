{"policyVersion":3,"items":[{"translations":{"en":["",""],"ja":["",""]},"airedAt":null,"relations":[],"id":"mal-13335","ids":{"shikimori":13335,"mal":13335,"anilist":null,"kodik":"movie-49115"},"kodikIds":["movie-10085","movie-49115"],"kodikRevisions":{"movie-10085":"2019-11-14T23:33:58Z","movie-49115":"2020-02-10T12:26:56Z"},"title":"Фусэ: Детективная история о девушке с ружьём","originalTitle":"Fuse: teppô musume no torimonochô","alt":"Фусэ: Повесть об охотнице","description":"] Хамадзи после смерти своего дедушки приходит из горной деревни в Эдо, где живёт её брат. В Эдо она знакомится с таинственным молодым человеком, Сино, и узнаёт про охоту на фусэ (дитя собаки и человека), монстров, за которых сёгун назначил большую награду. Она решает помочь своему брату заработать денег, убивая фусэ. Но действительно ли фусэ такие монстры, как про них думают люди? В основу аниме легло произведение Бакина Кёкутэя «Легенда о восьми псах-воинах клана Сатоми».","year":2012,"type":"MOVIE","genres":["Экшен","Драма","Сверхъестественное","исторический"],"rating":7.27,"popularity":0,"ongoing":false,"relatedMalIds":[],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/13335/f378997f12582b1bc8366e7065c23e5f.jpeg","width":705,"height":990},"backdrop":{"url":"https://shikimori.io/system/screenshots/original/ea9b7af5a9bd21fe7187794f88fda70cdbf3f302.jpg","width":1280,"height":720}},"releasedEpisodes":[1],"episodes":[{"number":1,"ordinal":1,"season":1,"audio":[{"id":"kodik-609","dubId":"609","label":"AniDUB","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"movie-10085","translationId":"609","url":"https://kodikplayer.com/video/10085/25f12809e1dc2480ad925a79d9ae055e/720p","season":1,"ordinal":1}},{"id":"kodik-761","dubId":"761","label":"Onibaku","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"end