{"policyVersion":3,"items":[{"id":"mal-63382","ids":{"shikimori":63382,"mal":63382,"anilist":206949,"kodik":"serial-78620"},"kodikIds":["serial-78765","serial-78631","serial-78620","serial-78704","serial-78699","serial-78759","serial-78638","serial-78632"],"kodikRevisions":{"serial-78765":"2026-10-22T06:48:17Z","serial-78631":"2026-10-27T19:37:40Z","serial-78620":"2026-10-27T14:59:50Z","serial-78704":"2026-10-21T21:25:17Z","serial-78699":"2026-10-21T20:23:44Z","serial-78759":"2026-10-22T22:09:07Z","serial-78638":"2026-10-27T19:32:55Z","serial-78632":"2026-10-27T17:32:20Z"},"title":"Безжалостная леди Ния Листон: Единственная в своём роде история воительницы-богоубийцы, перевоплотившейся в болезненную аристократку","originalTitle":"Kyouran Reijou Nia Liston: Byoujaku Reijou ni Tensei Shita Kami-goroshi no Bujin no Karei Naru Musouroku","alt":"Безжалостная леди Ния Листон: Единственная в своём роде история воительницы-богоубийцы, перевоплотившейся в болезненную аристократку / Nia Liston: The Merciless Maiden Nia Liston: The Merciless Maiden 凶乱令嬢ニア・リストン","description":"Прикованная к смертному одру и, казалось бы, лишённая всякой надежды на выздоровление, юная Ния Листон вот-вот должна погибнуть от болезни. Не желая мириться с судьбой, её родители отчаянно ищут исцеление, обращаясь даже к самым сомнительным источникам, — и в итоге на пороге их дома появляется таинственный человек в капюшоне, утверждающий, что способен избавить Нию от недуга. Но вместо исцеления незнакомец переселяет в хрупкое тело девочки душу погибшего героя, не знавшего поражений в бою. Получив второй шанс на жизнь в облике Нии, героиня твёрдо намерена восстановить силы нового тела, используя технику под названием ци, чтобы уничтожить болезнь в самом её корне. Вместе с душой к Нии перешла и неутолимая жажда сражений — теперь девочка с новым рвением отправляется исследовать мир. Однако беспокойная душа героя жаждет найти достойного противника, способного одолеть её на поле боя, и потому куда бы Ния ни направилась, там неизменно воцаряется хаос.","year":2026,"type":"TV","genres":["Фэнтези","реинкарнация"],"rating":7.55,"popularity":25127,"ongoing":true,"relatedMalIds":[],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/63382/68cffb53e95dcd1cd28f22dbe8df7cdd.jpeg","width":424,"height":600},"backdrop":{"url":"https://shikimori.io/system/screenshots/original/a930fb5b133718fa3d41387716d685c3f7977f99.jpg","width":1920,"height":1080}},"releasedEpisodes":[1,2,3,4],"episodes":[{"number":1,"ordinal":1,"season":1,"audio":[{"id":"kodik-4167","dubId":"4167","label":"hon-kon studio","language":"ru","original":false,"duration":1449.031,"sources":[{"quality":720,"url":"https://cloud.solodcdn.com/useruploads/ce95d8c3-0471-41b8-ae57-706adbfb56bc/d074b752c39d267ac7960e69d39a2635:2026102403/720.mp4:hls:manifest.m3u8","stream":true,"checkedAt":"2026-10-23T15:14:01.999Z"},{"quality":480,"url":"https://cloud.solodcdn.com/useruploads/ce95d8c3-0471-41b8-ae57-706adbfb56bc/d074b752c39d267ac7960e69d39a2635:2026102403/480.mp4:hls:manifest.m3u8","stream":true,"checkedAt":"2026-10-23T15:14:02.159Z"},{"quality":360,"url":"https://cloud.solodcdn.com/useruploads/ce95d8c3-0471-41b8-ae57-706adbfb56bc/d074b752c39d267ac7960e69d39a2635:2026102403/360.mp4:hls:manifest.m3u8","stream":true,"checkedAt":"2026-10-23T15:14:02.438Z"}],"subtitles":[],"opening":null,"ending":null,"providerRef":{"provider":"kodik","releaseId":"serial-78765","translationId":"4167","url":"https://kodikplayer.com/seria/1675900/44c2b8856dc086cebcb153a2d9eeda18/720p","season":1,"ordinal":1},"validation":"provider-link"},{"id":"kodik-1554","dubId":"1554","label":"FSG Sanae.Subtitles","language":"ja","original":true,"duration":1442.524,"sources":[{"quality":720,"url":"https://cloud.solodcdn.com/useruploads/5616492b-be3f-49b1-8220-e09ef4d0f428/7039884a30c831089585d14c2598d7dc:2026102403/720.mp4:hls:manifest.m3u8","stream":true,"checkedAt":"2026-10-23T15:14:04.132Z"},{"quality":480,"url":"https://cloud.solodcdn.com/u