{"policyVersion":3,"items":[{"translations":{"en":["",""],"ja":["",""]},"airedAt":null,"relations":[],"id":"mal-63509","ids":{"shikimori":63509,"mal":63509,"anilist":208025,"kodik":"serial-78916"},"kodikIds":["serial-78575","serial-78533","serial-78574","serial-78731","serial-78589","serial-78534","serial-79375","serial-78916"],"kodikRevisions":{"serial-78575":"2026-10-27T19:37:09Z","serial-78533":"2026-11-01T18:03:27Z","serial-78574":"2026-11-02T15:23:33Z","serial-78731":"2026-10-28T14:38:14Z","serial-78589":"2026-10-27T05:27:52Z","serial-78534":"2026-11-02T06:43:43Z","serial-79375":"2026-11-01T13:43:41Z","serial-78916":"2026-10-29T13:51:52Z"},"title":"Я встречаюсь с тёмным призывателем","originalTitle":"Dark Summoner to Dekiteiru","alt":"I'm Dating a Dark Summoner I'm Dating a Dark Summoner ダークサモナーとデキている","description":"Тёмная призывательница Амона Джин и священник Рони Гардихаус — полные противоположности, которые по всем законам фэнтези должны презирать друг друга. Однако у судьбы и алкоголя были другие планы: в первую же ночь совместного похода они поддаются мимолётной страсти и переступают черту. Теперь, скованная общим пикантным секретом, эта парочка вынуждена вести двойную жизнь. Днём они — напарники по отряду, которые делают вид, что едва терпят друг друга, а ночью — пылкие любовники. Только вот главная задача в этом походе — сохранить свой секрет, ведь бдительные товарищи по отряду всегда находятся на расстоянии вытянутой руки.","year":2026,"type":"ONA","genres":["Комедия","Фэнтези","эротика"],"rating":6.87,"popularity":25386,"ongoing":true,"relatedMalIds":[],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/63509/9c4b52857b74c40d66d5b4f39ec6a556.jpeg","width":422,"height":600},"backdrop":{"url":"https://shikimori.io/system/screenshots/original/fa27eed085a603bb370fbd839286309f1e0e3dd7.jpg","width":1920,"height":1080}},"releasedEpisodes":[1,2,3,4,5],"episodes":[{"number":1,"ordinal":1,"season":1,"audio":[{"id":"kodik-2491","dubId":"2491