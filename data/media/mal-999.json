{"policyVersion":3,"items":[{"translations":{"en":["",""],"ja":["",""]},"airedAt":null,"relations":[],"id":"mal-999","ids":{"shikimori":999,"mal":999,"anilist":null,"kodik":"serial-35390"},"kodikIds":["serial-20532","serial-35390"],"kodikRevisions":{"serial-20532":"2019-12-31T06:04:47Z","serial-35390":"2021-06-22T15:02:05Z"},"title":"Голубое семя 2","originalTitle":"Blue Seed 2","alt":"","description":"С победы над арагами прошло два года. С тех пор они больше не появлялись. ЗЦУ распущена, а её члены разбежались кто куда. Япония давно уже восстановилась от разрушений и живёт дальше. А вот в отношениях Момидзи и Мамору сплошной разлад, и они всё больше отдаляются друг от друга. Но всё меняет красноволосая красотка Валенсия Татибана, прибывшая за помощью из Сан-Франциско, где вновь дают о себе знать арагами. Старая команда из ЗЦУ собирается вместе снова, чтобы дать отпор новой угрозе и узнать, кто же стоит за всем этим.","year":1996,"type":"OVA","genres":["сэйнэн","Экшен","Приключения","Драма","Ужасы","тайна","Сверхъестественное","мифология"],"rating":6.47,"popularity":0,"ongoing":false,"relatedMalIds":[],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/999/4d912570c78732a37124ab14d83347c8.jpeg","width":225,"height":342},"backdrop":{"url":"https://shikimori.io/system/screenshots/original/b8ab662b18fbf1b3d56dfac95cb506bcac3df742.jpg","width":640,"height":480}},"releasedEpisodes":[1,2,3],"episodes":[{"number":1,"ordinal":1,"season":2,"audio":[{"id":"kodik-609","dubId":"609","label":"AniDUB","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-20532","translationId":"609","url":"https://kodikplayer.com/seria/548727/aa3b9f6265dd20e6f579fc22476b7689/720p","season":2,"ordinal":1}},{"id":"kodik-827","dubId":"827","label":"Persona99","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":n