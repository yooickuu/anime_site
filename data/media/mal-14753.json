"season":1,"ordinal":5}}]},{"number":6,"ordinal":6,"season":1,"audio":[{"id":"kodik-3079","dubId":"3079","label":"Манипулятор.Subtitles","language":"ja","original":true,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-55849","translationId":"3079","url":"https://kodikplayer.com/seria/1245218/12bc0e423be2d06620e20232e9fcf739/720p","season":1,"ordinal":6}}]}],"translations":{"en":["Hori-san to Miyamura-kun","People say that the youthful days are always bittersweet, but maybe it's just bitter? \n\n\r\nKyouko Hori is a flashy high school girl, who, despite her ostentatious appearance, excels in academics and has a family-loving character. Izumi Miyamura is a bland high school boy, who, despite not wanting to stand out in class, secretly wears piercings outside of school and has a large body tattoo. \n\n\r\nOne day, Miyamura finds Hori's little brother injured and helps him back to Hori's house, where the relationship between Hori and Miyamura begins with Hori's discovery of Miyamura's secret."],"ja":["堀さんと宮村くん",""]},"kodikRevisions":{"serial-55849":"2023-12-08T11:13:34Z","serial-8079":"2020-10-31T22:28:01Z","serial-25669":"2020-05-13T18:42:06Z"},"kodikIds":["serial-55849","serial-8079","serial-25669"],"relatedMalIds":[],"rating":7.43,"availableEpisodeCount":6}]}