{"policyVersion":3,"items":[{"translations":{"en":["",""],"ja":["",""]},"airedAt":null,"relations":[],"id":"mal-1731","ids":{"shikimori":1731,"mal":1731,"anilist":null,"kodik":"serial-8637"},"kodikIds":["serial-8637"],"kodikRevisions":{"serial-8637":"2021-01-31T20:06:05Z"},"title":"Сказания Симфонии: Сильварант","originalTitle":"Tales of Symphonia The Animation","alt":"Tales of Symphonia The Animation: Sylvarant Episode","description":"Мир, называемый Сильварант, постепенно увядает. Спасти его может лишь Избранная, совершив крестовый ход к башне ангелов. Колетт Брунель с детства знает о своём предназначении и готова выполнить его, несмотря на грядущие испытания. Странствие её начинается со внезапного нападения на церковь и множества жертв, и продолжается ничуть не легче — слишком многие в этом мире не согласны с действиями Избранной. Но Ллойд Ирвинг и Джиниус Сэйдж готовы пойти на всё, чтобы поддержать свою подругу в этом святом походе. Вот только мир за пределами родной деревни оказывается гораздо больше, чем они ожидали.","year":2007,"type":"OVA","genres":["Экшен","Приключения","Фэнтези","боевые искусства"],"rating":7.15,"popularity":0,"ongoing":false,"relatedMalIds":[],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/1731/e38dc8cf1c3b3be8867b7028173e4dac.jpeg","width":700,"height":995},"backdrop":{"url":"https://shikimori.io/system/screenshots/original/e216a779ae688f8f61f4be25485cd1890c47f6ac.jpg","width":1280,"height":720}},"releasedEpisodes":[1,2,3,4],"episodes":[{"number":1,"ordinal":1,"season":1,"audio":[{"id":"kodik-1177","dubId":"1177","label":"Valkrist & Keneretta","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-8637","translationId":"1177","url":"https://kodikplayer.com/seria/223463/92fd7800ee2cd002610d3d71c0c1083e/720p","season":1,"ordinal":1}}]},{"number":2,"ordinal":2,"season":1,"audio":[{"id