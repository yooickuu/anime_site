ionId":"827","url":"https://kodikplayer.com/seria/1207039/423607d28d506765a4981fc277505d01/720p","season":1,"ordinal":12}},{"id":"kodik-1613","dubId":"1613","label":"Risens Team","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-46008","translationId":"1613","url":"https://kodikplayer.com/seria/1057235/08e42bf9b4b291b3f857ce5d9b8a2311/720p","season":1,"ordinal":12}},{"id":"kodik-2063","dubId":"2063","label":"Saturn Union","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-39607","translationId":"2063","url":"https://kodikplayer.com/seria/937181/b5ec784735d80a6155d5789c010ce8c5/720p","season":1,"ordinal":12}}],"season":1,"ordinal":12}],"translations":{"en":["Land of the Lustrous","In the mysterious future, crystalline organisms called Gems inhabit a world that has been destroyed by six meteors. Each Gem is assigned a role in order to fight against the Lunarians, a species who attacks them in order to shatter their bodies and use them as decorations.\n\n\n\nPhosphophyllite, also known as Phos, is a young and fragile Gem who dreams of helping their friends in the war effort. Instead, they are told to compile an encyclopedia because of their delicate condition. After begrudgingly embarking on this task, Phos meets Cinnabar, an intelligent gem who has been relegated to patrolling the isolated island at night because of the corrosive poison their body creates. After seeing how unhappy Cinnabar is, Phos decides to find a role that both of the rejected Gems can enjoy. Houseki no Kuni follows Phos' efforts to be useful and protect their fellow Gems."],"ja":["宝石の国",""]},"kodikRevisions":{"serial-53464":"2023-09-19T19:02:07Z","serial-46008":"2022-10-05T15:43:15Z","serial-39607":"2021-12-21T22:45:30Z"},"ko