{"policyVersion":3,"items":[{"id":"mal-268","ids":{"shikimori":268,"mal":268,"anilist":268,"kodik":"serial-65778"},"kodikIds":["serial-5931","serial-35266","serial-22608","serial-73332","serial-65778"],"kodikRevisions":{"serial-5931":"2019-12-22T13:33:02Z","serial-35266":"2021-06-16T13:20:06Z","serial-22608":"2020-02-08T20:45:00Z","serial-73332":"2026-02-11T15:55:56Z","serial-65778":"2025-07-10T18:00:13Z"},"title":"Золотой парень","originalTitle":"Golden Boy","alt":"Golden Boy: Sasurai no o-benkyô yarô GOLDEN BOY GOLDEN BOY さすらいのお勉強野郎","description":"На вид и не скажешь, но Кинтаро Оэ (大江 錦太郎) — гений, закончивший все университетские курсы и ушедший оттуда задолго до выпускного. Он становится путешественником, странствуя с места на место на своём велосипеде в поисках новых знаний о жизни, о мире, о женщинах. Он готов взяться за любую работу, чтобы испытать себя. Его путешествие приводит его в различные места и к различным женщинам, каждая из которых впоследствии влюбляется в трудолюбивого парня.","year":1995,"type":"OVA","genres":["сэйнэн","Приключения","Комедия","этти","взрослые персонажи","гэг юмор","работа"],"rating":8.04,"popularity":115241,"ongoing":false,"relatedMalIds":[],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/268/ed9e7664cabbfd500045cec2971ab4ce.jpeg","width":475,"height":635},"backdrop":{"url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/268-jNnYUyUe4vKC.jpg","width":1087,"height":1200}},"releasedEpisodes":[1,2,3,4,5,6],"episodes":[{"number":1,"ordinal":1,"season":1,"audio":[{"id":"kodik-707","dubId":"707","label":"MTV","language":"ru","original":false,"duration":1734.309,"sources":[{"quality":720,"url":"https://cloud.solodcdn.com/useruploads/88c43cde-75c1-478d-af98-ecd75f4886b3/0a4f01835298316704b54463d3f8c8d8:2026102405/480.mp4:hls:manifest.m3u8","stream":true,"checkedAt":"2026-10-23T17:07:32.327Z"},{"quality":480,"url":"https://cloud.solodcdn.com/useruploads/88c43cde-75c1-478d-af98-ecd75f4886b3/0a4f01835298316