lways=1","stream":true},{"quality":480,"url":"https://cache-rfn.libria.fun/videos/media/ts/8420/12/480/bc38c8c5d6b350793a1df988897983cf.m3u8?countryIso=KZ&isAuthorized=0&isWithVideoAds=1&isWithVideoAdsAlways=1","stream":true}],"subtitles":[],"opening":{"start":65,"end":153},"ending":{"absent":true}},{"id":"kodik-1343","dubId":"1343","label":"TAKEOVER Project","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-32712","translationId":"1343","url":"https://kodikplayer.com/seria/788476/b589524b779bb5c083ff19eb18f78d90/720p","season":1,"ordinal":12}},{"id":"kodik-963","dubId":"963","label":"Amazing Dubbing","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-30348","translationId":"963","url":"https://kodikplayer.com/seria/739694/54d8d25fae3f3e22ddf2998d14736af2/720p","season":1,"ordinal":12}},{"id":"kodik-767","dubId":"767","label":"SHIZA Project","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-21926","translationId":"767","url":"https://kodikplayer.com/seria/571966/a25a691d748585185080b543db74e1f8/720p","season":1,"ordinal":12}}],"season":1,"ordinal":12}],"translations":{"en":["A Certain Scientific Accelerator","The espers of Academy City are classified into six levels, where \"Level 0\" lacks power while \"Level 5\" possesses an overwhelming amount. Of the several million espers residing in Academy City, only seven of them have attained Level 5, and ranked highest among them is the one known as Accelerator.\n\n\n\nToaru Kagaku no Accelerator focuses on the strongest Level 5 after he protects the cheerful Last Order at the price of much of his power. Recovering at the hospital, Accelerator has led a relatively quiet life until he ends up saving the life of Estelle Rosenthal, a mysterious girl carrying a photo of Last Order. Unfortunately, Accelerator now finds himself dragged into a new conflict in the form of a sinister organization called Disciplinary Action which plots to use Last Order for a dangerous mission. Now that they have set their plan into motion and are in pursuit of the young girl, it's up to the world's most powerful esper and his newfound companion to protect Last Order and defend Academy City in the process.\n\n\n\n(Source: MAL Rewrite)"],"ja":["とある科学の一方通行【アクセラレータ】",""]},"kodikRevisions":{"serial-32712":"2021-02-17T13:49:38Z","serial-30348":"2020-12-09T17:00:03Z","serial-21926":"2020-01-29T11:27:59Z"},"kodikIds":["serial-32712","serial-30348","serial-21926"],"relatedMalIds":[],"availableEpisodeCount":12,"rating":7.21}]}