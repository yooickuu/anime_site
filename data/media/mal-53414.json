{"policyVersion":3,"items":[{"translations":{"en":["",""],"ja":["",""]},"airedAt":null,"relations":[],"id":"mal-53414","ids":{"shikimori":53414,"mal":53414,"anilist":null,"kodik":"serial-47444"},"kodikIds":["serial-47437","serial-48328","serial-47444"],"kodikRevisions":{"serial-47437":"2023-01-14T08:31:27Z","serial-48328":"2023-01-24T10:22:15Z","serial-47444":"2023-01-14T02:45:21Z"},"title":"Люпен: Начало","originalTitle":"Lupin Zero","alt":"LUPIN ZERO","description":"Данный сериал поведает нам историю становления великого вора Арсена Люпена III . Ещё в школьные годы Люпен любил лезть в чужие дела, находя приключения на свою голову. И вот юный сорванец оказывается на распутье: с одной стороны, его душа не лежит к тому, чтобы зарабатывать на жизнь честным трудом, а с другой, он не желает становиться таким же вором, как его дед или отец. Люпен ищет свой путь в жизни, а поможет ему в этом его новый товарищ Дайсукэ Дзигэн , который по воле случая оказался втянут в очередную авантюру своего будущего лучшего друга.","year":2022,"type":"ONA","genres":["сэйнэн","Экшен","Комедия"],"rating":7.42,"popularity":0,"ongoing":false,"relatedMalIds":[],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/53414/3493b98bb2aec2bf10d9d905d2838434.jpeg","width":725,"height":995},"backdrop":{"url":"https://shikimori.io/system/screenshots/original/3f8d1a582e364b626c54b4bef4d8881852af8d60.jpg","width":1920,"height":1080}},"releasedEpisodes":[1,2,3,4,5,6],"episodes":[{"number":1,"ordinal":1,"season":1,"audio":[{"id":"kodik-910","dubId":"910","label":"AniStar","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-47437","translationId":"910","url":"https://kodikplayer.com/seria/1082719/49b88aedd44643ec8fed558ef989a748/720p","season":1,"ordinal":1}},{"id":"kodik-1291","dubId":"1291","label":"Crunchyroll.Subtitles","language":"ja","original":tru