{"policyVersion":3,"items":[{"translations":{"en":["",""],"ja":["",""]},"airedAt":null,"relations":[],"id":"mal-8560","ids":{"shikimori":8560,"mal":8560,"anilist":null,"kodik":"serial-55688"},"kodikIds":["serial-21648","serial-55688"],"kodikRevisions":{"serial-21648":"2020-01-22T22:40:21Z","serial-55688":"2023-11-28T16:54:50Z"},"title":"Сегодня начнётся наша любовь","originalTitle":"Kyou, Koi o Hajimemasu","alt":"Сегодня начнется наша любовь / Сегодня началась наша любовь","description":"Цубаки любит делать разные причёски своей младшей сестрёнке, но о себе особым образом никогда не задумывается. Надеясь стать спикером на церемонии открытия в старшей школе (самым успешным учеником, который по обычаю произносит речь), она терпит неудачу, а тем, кто её обошел, оказывается для неё самым жутким кошмаром и однофамильцем — Кётой ! После первой же грубой перепалки она попросту обрезает ему волосы ножницами. В ответ Кёта требует, чтобы она расплатилась с ним своим собственным телом, после чего Цубаки обрезает волосы юноши ещё короче, и тогда Кёта внезапно целует её и обещает, что украдет у неё каждый первый опыт.","year":2010,"type":"OVA","genres":["седзе","Романтика","Школа"],"rating":6.44,"popularity":0,"ongoing":false,"relatedMalIds":[],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/8560/e60dea4f2fff1cc55dfe2252e71e14dc.jpeg","width":319,"height":450},"backdrop":{"url":"https://shikimori.io/system/screenshots/original/c820d22f27e5ca6ca7570fc9ba923ef0e48debe7.jpg","width":853,"height":480}},"releasedEpisodes":[1,2],"episodes":[{"number":1,"ordinal":1,"season":1,"audio":[{"id":"kodik-767","dubId":"767","label":"SHIZA Project","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-21648","translationId":"767","url":"https://kodikplayer.com/seria/566825/3f65eac4eefd8c1a75c1226d792adb2b/720p","season":1,"ordinal":1}},{"i