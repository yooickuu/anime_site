ンス",""]},"kodikRevisions":{"serial-27709":"2022-11-24T10:38:04Z","serial-29251":"2021-07-12T08:25:01Z","serial-28030":"2021-10-23T16:29:00Z"},"kodikIds":["serial-27709","serial-29251","serial-28030"],"relatedMalIds":[],"availableEpisodeCount":12,"rating":7.35}]}