3/1080/b201cb8daf8b4fc276cc945344f47250.m3u8?countryIso=KZ&isAuthorized=0&isWithVideoAds=1&isWithVideoAdsAlways=1","stream":true},{"quality":720,"url":"https://cache-rfn.libria.fun/videos/media/ts/10242/13/720/0e68a5a0e925dc656cbf177095a6c5cb.m3u8?countryIso=KZ&isAuthorized=0&isWithVideoAds=1&isWithVideoAdsAlways=1","stream":true},{"quality":480,"url":"https://cache-rfn.libria.fun/videos/media/ts/10242/13/480/a8be5b8e7bc5a4f8896551dac06e4035.m3u8?countryIso=KZ&isAuthorized=0&isWithVideoAds=1&isWithVideoAdsAlways=1","stream":true}],"subtitles":[],"opening":{"absent":true},"ending":{"start":1352,"end":1533}},{"id":"kodik-3957","dubId":"3957","label":"Flowers Media","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-76655","translationId":"3957","url":"https://kodikplayer.com/seria/1680155/b77172c577146d0e7a3a468bf03e8bd1/720p","season":1,"ordinal":13}},{"id":"kodik-4126","dubId":"4126","label":"CV POINT","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-76824","translationId":"4126","url":"https://kodikplayer.com/seria/1678635/61db2dc90b93b11fa2f64943b44d7bd2/720p","season":1,"ordinal":13}},{"id":"kodik-2822","dubId":"2822","label":"AniBaza","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-76968","translationId":"2822","url":"https://kodikplayer.com/seria/1675568/d5d21407627c44a5023ca5e764b660c7/720p","season":1,"ordinal":13}}],"season":1,"ordinal":13}],"translations":{"en":["Sparks of Tomorrow","The novel takes place in the summer of 1907, the 40th year of the Meiji era. 15-year-old Inako Momokawa lives in the Fushimi area of Kyoto, and is the second daughter of a sake brewer. Nothing she does ever comes out right, and she receives a scolding from her father every day. Her only relief is the trust she places in her prayers to the gods. One day while at Fushimi Inari shrine, she meets a freewheeling young man named Kihachi Sakamoto. He rejects the gods, and boasts of the incoming age of electricity. \n\n\n\nThe topic of marriage suddenly comes up in Inako's household. Her father is one-sidedly making all the decisions for her, and Inako is about to give up hope. It is then that Kihachi draws out Inako's true feelings of wanting to run away from her family. The only way to stop her marriage is to find an unusual book called the \"Electricity Catalog.\" The book is a prediction book about electricity that Kihachi wrote when he was a child, but his older brother Seiroku took the book, and its current whereabouts are unknown. Inako and Kihachi together go in search of the book across Kyoto and Shiga prefectures.\n\n\n\n(Source: Anime News Network)"],"ja":["二十世紀電氣目録-ユーレカ・エヴリカ-",""]},"kodikRevisions":{"serial-76655":"2026-10-19T03:47:19Z","serial-76824":"2026-10-15T09:06:25Z","serial-76968":"2026-10-08T10:04:05Z"},"kodikIds":["serial-76655","serial-76824","serial-76968"],"relatedMalIds":[],"rating":7.44,"availableEpisodeCount":13}]}