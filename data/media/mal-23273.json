ranslationId":"559","url":"https://kodikplayer.com/seria/567921/00f3290be16c186168c950c908cf9bc0/720p","season":1,"ordinal":22}},{"id":"kodik-610","dubId":"610","label":"AniLibria.TV","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-7938","translationId":"610","url":"https://kodikplayer.com/seria/207640/d721fe46df14f19477c85f46f4314719/720p","season":1,"ordinal":22}},{"id":"kodik-767","dubId":"767","label":"SHIZA Project","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-10370","translationId":"767","url":"https://kodikplayer.com/seria/277118/ff1ddd27df91ad3ab89f8e1bc19adafb/720p","season":1,"ordinal":22}}],"season":1,"ordinal":22}],"translations":{"en":["Your lie in April","Piano prodigy Arima Kousei dominated the competition and all child musicians knew his name. But after his mother, who was also his instructor, passed away, he had a mental breakdown while performing at a recital. This resulted in him no longer being able to hear the sound of his piano playing. Two years later, Kousei hasn’t touched the piano and views the world without any flair or color. He was content at living out his life with his good friends Tsubaki and Watari until, one day, a girl changed everything. Miyazono Kaori is a pretty, free spirited violinist whose playing style reflects her personality. Kaori helps Kousei return to the music world and show that it should be free and mold breaking unlike the structured and rigid style Kousei was used to."],"ja":["四月は君の嘘",""]},"kodikRevisions":{"serial-21710":"2023-02-12T09:05:02Z","serial-7938":"2019-12-11T17:10:47Z","serial-10370":"2018-05-10T20:43:49Z"},"kodikIds":["serial-21710","serial-7938","serial-10370"],"relatedMalIds":[28069],"availableEpisodeCount":22,"rating":8