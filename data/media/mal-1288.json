{"policyVersion":3,"items":[{"translations":{"en":["",""],"ja":["",""]},"airedAt":null,"relations":[],"id":"mal-1288","ids":{"shikimori":1288,"mal":1288,"anilist":null,"kodik":"serial-7529"},"kodikIds":["serial-7528","serial-7529"],"kodikRevisions":{"serial-7528":"2019-12-24T15:59:13Z","serial-7529":"2019-12-06T22:06:41Z"},"title":"Полиция будущего OVA","originalTitle":"Kidou Keisatsu Patlabor","alt":"Kidô keisatsu patorebâ","description":"В будущем для потребностей тяжёлой промышленности и масштабных строительных проектов понадобилось нечто куда более эффективное, нежели ручной труд. Быстро развивающиеся технологии дали возможность создать гигантских роботов, названных «лэйборами», которые позволили добиться необычайного успеха в строительстве и… преступлениях. В результате для противостояния «лэйбор-преступности» токийской полицией было создано специальное подразделение, оснащённое лэйборами. Изуми Ноа — весьма бойкая и влюблённая по уши в роботов женщина-полицейский, становится новобранцем второго отдела Специального мобильного подразделения («Патлэйбор»). Это история о буднях полицейского управления, об их приключениях с участием сумасшедших строителей, эко-террористов, привидений и морских чудовищ.","year":1988,"type":"OVA","genres":["Комедия","Фантастика","взрослые персонажи","меха","работа"],"rating":7.3,"popularity":0,"ongoing":false,"relatedMalIds":[],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/1288/13180045cb676553354511139c291323.jpeg","width":275,"height":390},"backdrop":{"url":"https://shikimori.io/system/screenshots/original/b3ad1336e1e4130a464e368698dd484e2ec58ff0.jpg","width":1440,"height":1080}},"releasedEpisodes":[1,2,3,4,5,6,7],"episodes":[{"number":1,"ordinal":1,"season":1,"audio":[{"id":"kodik-568","dubId":"568","label":"Vulpes Vulpes","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"seri