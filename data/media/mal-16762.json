{"policyVersion":3,"items":[{"id":"mal-16762","ids":{"shikimori":16762,"mal":16762,"anilist":16762,"kodik":"movie-9913"},"kodikIds":["movie-9913"],"kodikRevisions":{"movie-9913":"2019-11-19T21:02:01Z"},"title":"Дневник будущего: Повторный набор","originalTitle":"Mirai Nikki Redial","alt":"Дневник будущего OVA-2 The Future Diary: Redial 未来日記リダイヤル","description":"Действия серии происходит спустя некоторое время после завершения оригинального сериала. По ходу сюжета мы встречаемся со всеми главными героями (хранителями дневников) сериала и узнаем, что Деус все еще не может решить, каким образом избрать нового бога, а ведь времени осталось совсем мало. Юно Гасай из третьего мира вдруг начинает видеть воспоминания Юно из первого. Она живет с ощущением, что потеряла нечто очень ценное для себя, но никак не может вспомнить что или кого именно; это сильно беспокоит юную девушку. Что же будет, если она все вспомнит: начало новой игры, начало конца или же все-таки хеппи-энд?","year":2013,"type":"OVA","genres":["Сёнен","Сверхъестественное","Триллер","психологическое"],"rating":7.28,"popularity":89189,"ongoing":false,"relatedMalIds":[10620],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/16762/5ddb5c6f9703cc3ea1811c48ab0630bb.jpeg","width":685,"height":975},"backdrop":{"url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/16762-OSYknXvwmKxI.jpg","width":1900,"height":600}},"releasedEpisodes":[1],"episodes":[{"number":1,"ordinal":1,"season":1,"audio":[{"id":"kodik-609","dubId":"609","label":"AniDUB","language":"ru","original":false,"duration":1800.106,"sources":[{"quality":720,"url":"https://cloud.solodcdn.com/useruploads/e73ed187-4489-4709-bad5-adc2bb33f4c1/34225d8cd6029b5a13690ec9637e01cb:2026102405/720.mp4:hls:manifest.m3u8","stream":true,"checkedAt":"2026-10-23T17:37:45.431Z"},{"quality":480,"url":"https://cloud.solodcdn.com/useruploads/e73ed187-4489-4709-bad5-adc2bb33f4c1/34225d8cd6029b5a13690ec9637e01cb:2026102405/480.mp4:hls:manifest.m3u8"