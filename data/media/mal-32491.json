alidation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-67127","translationId":"2023","url":"https://kodikplayer.com/seria/1452265/66248b30f20ba6276abe187b40c3e495/720p","season":1,"ordinal":4}}],"season":1,"ordinal":4}],"translations":{"en":["She and Her Cat -Everything Flows-","For the longest time, it's just been the two of them. \"Kanojo\" and her cat Daru are inseparable, having grown up together. Now a junior in college, Tomoka—her roommate of a year and a half—moves out of their shared apartment, and in order to keep her living space, Kanojo must find a job. Day by day, Daru watches her continued efforts from a cat's-eye view, eagerly awaiting his owner's return. When she gets back, once again, it's just she and her cat.\n\n\n\nKanojo to Kanojo no Neko: Everything Flows is a charming short series about the bond between a pet and his owner."],"ja":["彼女と彼女の猫 -Everything Flows-",""]},"kodikRevisions":{"serial-73430":"2026-03-01T00:38:07Z","serial-67128":"2025-04-29T23:09:43Z","serial-67127":"2025-04-29T22:53:29Z"},"kodikIds":["serial-73430","serial-67128","serial-67127"],"relatedMalIds":[],"rating":7.66,"availableEpisodeCount":4}]}