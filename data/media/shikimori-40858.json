{"policyVersion":3,"items":[{"id":"shikimori-40858","ids":{"mal":40858,"shikimori":40858,"anilist":113917,"anilibria":8849,"kodik":"serial-24575"},"title":"Психопаспорт 3: Первый инспектор","originalTitle":"Psycho-Pass 3: First Inspector","alt":"Психопаспорт 3: Первый инспектор Psycho-Pass 3: First Inspector Psycho-Pass 3: First Inspector","year":2020,"type":"TV","genres":["Экшен","Тайна","Фантастика","Триллер","Взрослые персонажи","Детектив","Психологическое"],"description":"Инспекторы первого отдела ] Арата Синдо и Кэй Михаил Игнатов продолжают расследовать деятельность таинственной организации «Биврёст» и всё ближе подбираются к раскрытию тайны загадочной смерти своих родных. Однако члены «Биврёста» не собираются останавливаться и начинают финальный раунд своей безжалостной игры. Теперь под удар попадает само Бюро, а его сотрудникам предстоит пройти через смертельные испытания. Смогут ли они остановить преступников и остаться верными своим принципам, когда на кону жизни их товарищей?","ongoing":false,"releasedEpisodes":[1,2,3,4,5,6],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/40858/3e985c0f1aa4765f71c23e54bf7a9d9c.jpeg","width":700,"height":990},"backdrop":{"url":"https://s4.anilist.co/file/anilistcdn/media/anime/banner/113917-VeFrqlpwPvly.jpg","width":1900,"height":360}},"episodes":[{"number":1,"ordinal":1,"season":1,"audio":[{"id":"kodik-869","dubId":"869","label":"Субтитры","language":"ja","original":true,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-24575","translationId":"869","url":"https://kodikplayer.com/seria/626373/8e64c0db4bd37c49d6fe89512fe7000a/720p","season":1,"ordinal":1}},{"id":"kodik-610","dubId":"610","label":"AniLibria.TV","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodik","releaseId":"serial-3