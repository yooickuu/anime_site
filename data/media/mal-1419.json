{"policyVersion":3,"items":[{"translations":{"en":["",""],"ja":["",""]},"airedAt":null,"relations":[],"id":"mal-1419","ids":{"shikimori":1419,"mal":1419,"anilist":null,"kodik":"movie-63943"},"kodikIds":["movie-58591","movie-60614","movie-63943"],"kodikRevisions":{"movie-58591":"2020-08-05T11:03:20Z","movie-60614":"2020-09-17T15:58:39Z","movie-63943":"2020-12-07T22:52:57Z"},"title":"Люпен III: К чёрту Нострадамуса!","originalTitle":"Rupan sansei: Kutabare! Nastradamus","alt":"Люпен III: К черту Нострадамуса! (фильм пятый)","description":"После очередного успешного ограбления Арсен Люпен III садится в самолёт и покидает Бразилию с одной лишь куклой, в которую он спрятал украденный бриллиант. Однако во время полёта игрушку забирает маленькая девочка Джулия , летящая тем же рейсом со своей няней, которой оказывается сама Фудзико Минэ . Но прежде чем Люпен успевает вернуть драгоценный камень, самолёт захватывают, а девочку похищают. Похитители хотят использовать Джулию, чтобы добраться до сокровища её отца — книги с предсказаниями Нострадамуса. Именно за этим артефактом охотилась Фудзико, но теперь в поиски включаются и Люпен с его бандой. Вместе им предстоит спасти девочку, вернуть бриллиант и раскрыть секреты древней книги!","year":1995,"type":"MOVIE","genres":["сэйнэн","Экшен","Приключения","Комедия","тайна","взрослые персонажи"],"rating":7.36,"popularity":0,"ongoing":false,"relatedMalIds":[],"artwork":{"poster":{"url":"https://shikimori.io/uploads/poster/animes/1419/8c175c64baa29579591d55526dfb7dfd.jpeg","width":365,"height":520},"backdrop":{"url":"https://shikimori.io/system/screenshots/original/e346fce4f6af255b711c9e905c19153b4707b13d.jpg","width":1280,"height":720}},"releasedEpisodes":[1],"episodes":[{"number":1,"ordinal":1,"season":1,"audio":[{"id":"kodik-1048","dubId":"1048","label":"Евгения Лурье","language":"ru","original":false,"duration":null,"sources":[],"subtitles":[],"opening":null,"ending":null,"validation":"provider-link","providerRef":{"provider":"kodi